{
  "name": "nomad-site",
  "private": true,
  "type": "module",
  "description": "nomad.ax: React pages on nomad-design, prerendered to static HTML at build time and hydrated per page, plus the /dl Pages Functions.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node tools/build.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node tools/check-site.mjs",
    "test": "node --test tools/releases.test.mjs",
    "serve": "node tools/serve.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "iconsax-react": "0.0.8",
    "lenis": "1.3.26",
    "nomad-design": "file:../nomad-design",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
