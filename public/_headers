# Cloudflare Pages response headers for nomad.ax.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Built by Vite with a content hash in every name: a changed file is a new
# URL, so these are cached forever.
/_s/*
  Cache-Control: public, max-age=31536000, immutable

# Hand-kept images and icons, not content-hashed: cached for a day, so a
# changed icon reaches everyone by tomorrow at the latest.
/assets/*
  Cache-Control: public, max-age=86400
