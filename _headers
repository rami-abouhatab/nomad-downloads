# Cloudflare Pages response headers for nomad.ax.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Not content-hashed, so cached for a day rather than forever; a changed
# icon or stylesheet reaches everyone by tomorrow at the latest.
/assets/*
  Cache-Control: public, max-age=86400

/site.css
  Cache-Control: public, max-age=3600

/site.js
  Cache-Control: public, max-age=3600
